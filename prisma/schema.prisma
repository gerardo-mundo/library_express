generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  USER
  ADMIN
  AUXILIARY
  STUDENT
  PROFESSOR
}

enum PublicationTypes {
  ARTICLE
  MAGAZINE
  NEWSPAPER
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String     @db.VarChar(120)
  last_name         String     @db.VarChar(120)
  email             String     @unique
  password          String
  role              Roles      @default(USER)
  created_at        DateTime   @default(now())
  last_session      DateTime?
  loans_as_borrower BookLoan[] @relation("BorrowerRelation")
  loans_as_approver BookLoan[] @relation("ApproverRelation")
}

model Book {
  id           Int        @id @default(autoincrement())
  title        String
  author       String
  author_two   String?
  author_three String?
  publisher    String
  collection   String
  adquisition  Int        @unique
  copies       Int
  available    Boolean
  created_at   DateTime   @default(now())
  loan_history LoanItem[]
  bookLoans    BookLoan[]
}

model Thesis {
  id             Int      @id @default(autoincrement())
  title          String   @unique
  author         String
  author_two     String?
  author_three   String?
  publisher      String
  thesis_advisor String
  copies         Int
  created_at     DateTime @default(now())
}

model Publication {
  id           Int              @id @default(autoincrement())
  type         PublicationTypes
  title        String           @unique
  author       String
  author_two   String?
  author_three String?
  copies       Int
  ISBN         String?
  ISSN         String?
  available    Boolean          @default(true)
  created_at   DateTime         @default(now())
}

model BookLoan {
  id          Int        @id @default(autoincrement())
  returned    Boolean    @default(false)
  loan_date   DateTime   @default(now())
  return_date DateTime?
  //FK's
  loan_items  LoanItem[]
  book        Book?      @relation(fields: [bookId], references: [id])
  bookId      Int?
  borrower    User       @relation("BorrowerRelation", fields: [borrower_id], references: [id])
  borrower_id String
  approver    User?      @relation("ApproverRelation", fields: [approver_id], references: [id])
  approver_id String?
}

model LoanItem {
  id         Int      @id @default(autoincrement())
  loan       BookLoan @relation(fields: [loan_id], references: [id])
  loan_id    Int
  book       Book     @relation(fields: [book_id], references: [id])
  book_id    Int
  returned   Boolean  @default(false)
  created_at DateTime @default(now())
}
